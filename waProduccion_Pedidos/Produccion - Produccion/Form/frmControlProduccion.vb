    Private Sub Fill_Colores()
        Try
            Dim pCodigo As String = String.Empty
            pCodigo = tlviewControlProduccion.GetRowCellValue(tlviewControlProduccion.FocusedRowHandle, "CodigoArticulo")

            Dim dtColores As New DataTable()
            dtColores = mConexion.ConectarSQLGT_DT("EXEC APGProduccion.dbo.[Ensamble_Ordenes_Hijos] CP," + pCodigo.ToString)

            'COLORES - Limpiar Controles
            DsControlProduccion1.Tables(DsControlProduccion1.dsdtColores.TableName.ToString).Clear()
            txtCodigoPadre.EditValue = Nothing

            'COLORES - Llenar Controles
            If Not dtColores.Rows.Count = Nothing Then
                txtCodigoPadre.EditValue = dtColores.Rows(0)("CodigoPadre")
                'LLENA LA TABLA DE COLORES
                DsControlProduccion1.Tables(DsControlProduccion1.dsdtColores.TableName.ToString).Merge(dtColores)
            End If


        Catch ex As Exception
            mMensajes.msg_Error(ex.Message.ToString)
        End Try
    End Sub


    Private Function Sub_Fill_Molde(ByVal pCodigo As String) As Boolean
        Try
            Dim dtMoldes As New DataTable("CodigosProducidosMoldes")
            dtMoldes = GET_Listado_CodigosProducidos(pCodigo)
            If dtMoldes.Rows.Count = Nothing Then
                Return False
            End If

            Dim dt As New DataTable("dtMaquinas")
            dt = mSQLSelect.GET_MoldesMaquinasParametros(dtMoldes.Rows(0)("Molde").ToString)

            txtMolde.EditValue = String.Empty
            txtNombre.EditValue = String.Empty
            txtCavidades.EditValue = String.Empty
            txtunidades.EditValue = String.Empty
            txtLugar.EditValue = String.Empty
            txtUbicacion.EditValue = String.Empty
            txtPreferencial.EditValue = String.Empty

            If dt.Rows.Count = Nothing Then
                Return False
            End If

            txtMolde.EditValue = dt.Rows(0)("Id").ToString
            txtNombre.EditValue = dt.Rows(0)("Nombre").ToString
            txtCavidades.EditValue = dt.Rows(0)("Cavidades").ToString
            txtunidades.EditValue = dt.Rows(0)("Unidades").ToString
            txtLugar.EditValue = dt.Rows(0)("Bodega").ToString
            txtUbicacion.EditValue = dt.Rows(0)("Ubicacion").ToString
            txtPreferencial.EditValue = dt.Rows(0)("MaquinaPreferencial").ToString

            Return True

        Catch ex As Exception
            mMensajes.msg_Error(ex.Message.ToString)
            Return False
        End Try
    End Function
