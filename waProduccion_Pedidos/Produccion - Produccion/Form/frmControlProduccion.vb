    Private Sub rbtnEtiquetas_ItemClick(sender As Object, e As DevExpress.XtraBars.ItemClickEventArgs) Handles rbtnEtiquetas.ItemClick
        Try
            Dim pCodigoPadre As String = String.Empty
            Dim pMaquina As String = String.Empty
            Dim pUbicacion As String = String.Empty
            Dim pUbicacionNombre As String = String.Empty

            pCodigoPadre = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "CodigoArticulo")
            pMaquina = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "Preferencial")

            Dim dtMaquina As New DataTable()
            dtMaquina = GET_Catalogo_Maquinas(pMaquina)

            If Not dtMaquina.Rows.Count = Nothing Then
                pUbicacion = dtMaquina.Rows(0)("Ubicacion").ToString
            End If

            pUbicacion = GET_Listado_MaquinasBodegas(pUbicacion).Rows(0)("Nombre").ToString

            rdlMenu.HidePopup()
            frmEtiquetasSolicitud.Text = "Solicitud de Etiquetas para Maquina " + pMaquina.ToString + " Ubicación " + pUbicacion
            frmEtiquetasSolicitud.vpCodigoPadre = pCodigoPadre
            frmEtiquetasSolicitud.vpMaquina = pMaquina

            frmEtiquetasSolicitud.ShowDialog(Me)
        Catch ex As Exception
            mMensajes.msg_Error(ex.Message.ToString)
        End Try
    End Sub


