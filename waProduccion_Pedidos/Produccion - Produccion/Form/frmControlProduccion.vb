    Private Sub FC_Chart2()
        ' Create a chart.

        Dim chart2 As ChartControl = ChartControl2

        ' Create an empty Bar series and add it to the chart.
        chart2.Series.Clear() 'limpiar las series
        'CREAR la Serie
        Dim series As New Series("Grupo", ViewType.Bar)
        chart2.Series.Add(series)

        Dim dt As New DataTable()
        dt = mConexion.ConectarSQLGT_DT("APGProduccion.dbo.[sp_HorasDeProduccion_PorGrupo]")

        ' Generate a data table and bind the series to it.
        series.DataSource = dt

        ' Generate a data table and bind the series to it.
        'series.DataSource = DsControlProduccion1.dsdtControlProduccion

        ' Specify data members to bind the series.
        series.ArgumentScaleType = ScaleType.Numerical
        series.ArgumentDataMember = "Grupo"
        series.ValueScaleType = ScaleType.Numerical
        series.ValueDataMembers.AddRange(New String() {"HorasPendiente"})
        series.ToolTipHintDataMember = "Grupo"

        ' Set some properties to get a nice-looking chart.
        CType(series.View, SideBySideBarSeriesView).ColorEach = True
        CType(chart2.Diagram, XYDiagram).AxisY.Visibility = DevExpress.Utils.DefaultBoolean.False
        chart2.Legend.Visibility = DevExpress.Utils.DefaultBoolean.False
        chart2.AnimationStartMode = ChartAnimationMode.OnDataChanged

        'CType(chart2.Diagram, DevExpress.XtraCharts.XYDiagram).Rotated = True

        ' Dock the chart into its parent and add it to the current form.
        chart2.Dock = DockStyle.Fill
        'Me.Controls.Add(chart)

    End Sub
    Private Sub FC_Chart()
        ' Create a chart.

        Dim chart As ChartControl = ChartControl1

        ' Create an empty Bar series and add it to the chart.
        ChartControl1.Series.Clear() 'limpiar las series
        'CREAR la Serie
        Dim series As New Series("Preferencial", ViewType.Bar)
        chart.Series.Add(series)

        Dim dt As New DataTable()
        dt = mConexion.ConectarSQLGT_DT("APGProduccion.dbo.[sp_HorasDeProduccion_PorMaquina]")

        ' Generate a data table and bind the series to it.
        series.DataSource = dt

        ' Generate a data table and bind the series to it.
        'series.DataSource = DsControlProduccion1.dsdtControlProduccion

        ' Specify data members to bind the series.
        series.ArgumentScaleType = ScaleType.Numerical
        series.ArgumentDataMember = "Preferencial"
        series.ValueScaleType = ScaleType.Numerical
        series.ValueDataMembers.AddRange(New String() {"HorasPendiente"})

        ' Set some properties to get a nice-looking chart.
        CType(series.View, SideBySideBarSeriesView).ColorEach = True
        CType(chart.Diagram, XYDiagram).AxisY.Visibility = DevExpress.Utils.DefaultBoolean.False
        chart.Legend.Visibility = DevExpress.Utils.DefaultBoolean.False
        chart.AnimationStartMode = ChartAnimationMode.OnDataChanged

        CType(chart.Diagram, DevExpress.XtraCharts.XYDiagram).Rotated = True

        ' Dock the chart into its parent and add it to the current form.
        chart.Dock = DockStyle.Fill
        'Me.Controls.Add(chart)

    End Sub

