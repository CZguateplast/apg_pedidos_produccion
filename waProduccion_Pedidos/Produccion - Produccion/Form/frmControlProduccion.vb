    Private Sub tlviewControlProduccion_ItemClick(sender As Object, e As Views.Tile.TileViewItemClickEventArgs) Handles tlviewControlProduccion.ItemClick
        Try
            Fill_Colores()

            'OBTENER CODIGO DE ARTICULO
            Dim pCodigo As String = String.Empty
            pCodigo = tlviewControlProduccion.GetRowCellValue(tlviewControlProduccion.FocusedRowHandle, "CodigoArticulo")


            If Not Sub_Fill_Molde(pCodigo) Then : mMensajes.msg_Informacion("No existen parametros de Molde.") : End If
            If Not Sub_Fill_Produccion_Paremetros(pCodigo) Then : mMensajes.msg_Informacion("No existen parametros de Produccion.") : End If

        Catch ex As Exception
            mMensajes.msg_Error(ex.Message.ToString)
        End Try
    End Sub

    Private Sub tlviewControlProduccion_FocusedRowChanged(sender As Object, e As Views.Base.FocusedRowChangedEventArgs) Handles tlviewControlProduccion.FocusedRowChanged
        Try
            'OBTENER CODIGO DE ARTICULO
            Dim pCodigo As String = String.Empty
            pCodigo = tlviewControlProduccion.GetRowCellValue(tlviewControlProduccion.FocusedRowHandle, "CodigoArticulo")

