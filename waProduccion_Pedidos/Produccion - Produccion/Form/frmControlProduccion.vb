    Private Sub rbtnIniciarProceso_ItemClick(sender As Object, e As DevExpress.XtraBars.ItemClickEventArgs) Handles rbtnIniciarProceso.ItemClick
        Try
            tlviewControlProduccion.Focus()
            If tlviewControlProduccion.IsFocusedView Then
                If tlviewControlProduccion.FocusedRowHandle > -1 Then
                    Dim pEstado As String = String.Empty
                    pEstado = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "Estado")
                    Select Case pEstado
                        Case "En Espera"
                            tlviewControlProduccion.SetRowCellValue(tlviewControlProduccion.FocusedRowHandle, "Estado", "En Proceso")
                            FCN_UPDATE_ProgramacionProduccion()
                        Case "Mantenimiento"
                            tlviewControlProduccion.SetRowCellValue(tlviewControlProduccion.FocusedRowHandle, "Estado", "En Proceso")
                            FCN_UPDATE_ProgramacionProduccion()
                    End Select
                End If


                rdlMenu.HidePopup()
                'barbtnIniciarProceso.Enabled = False
                'barbtnDetener.Enabled = True
                'barbtnBajar.Enabled = False
                'barbtnMaquinaCambiar.Enabled = False
            End If

        Catch ex As Exception
            mMensajes.msg_Error(ex.Message.ToString)
        End Try

    End Sub
    Private Function FCN_UPDATE_ProgramacionProduccion() As Boolean
        Try
            Dim pCodigoArticulo As String = String.Empty
            Dim pPreferencial As String = String.Empty
            Dim pEstado As String = String.Empty
            Dim pPrioridad As String = String.Empty
            Dim pPrioridadMaquina As String = String.Empty
            Dim pComentarios As String = String.Empty

            pCodigoArticulo = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "CodigoArticulo")
            pPreferencial = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "Preferencial")
            pEstado = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "Estado")
            pPrioridad = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "Prioridad")
            pPrioridadMaquina = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "PrioridadMaquina")
            pComentarios = mFunciones.FCN_GetCellValue(tlviewControlProduccion, "Comentarios")

            If mSQLUpdate.UPDATE_ProgramacionProduccion(pCodigoArticulo, pPreferencial, pEstado, pPrioridad, pPrioridadMaquina, pComentarios) Then
                Return True
            End If

            Return False
        Catch ex As Exception
            mMensajes.msg_Error(ex.Message.ToString)
            Return False
        End Try
    End Function


