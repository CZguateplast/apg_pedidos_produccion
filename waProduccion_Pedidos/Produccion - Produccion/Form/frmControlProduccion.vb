    Private Sub FCN_ProgramacionProduccion_Enumerar()
        Try
            Dim pPrioridadMaquina As Integer = 1
            For i = 0 To DsControlProduccion1.dsdtControlProduccion.Rows.Count - 1

                Dim pMaquinaAnterior As String = String.Empty
                Dim pMaquinaActual As String = String.Empty

                If i = 0 Then
                    pMaquinaAnterior = DsControlProduccion1.dsdtControlProduccion.Rows(Val(i))("Preferencial")
                Else
                    pMaquinaAnterior = DsControlProduccion1.dsdtControlProduccion.Rows(Val(i - 1))("Preferencial")
                End If

                pMaquinaActual = DsControlProduccion1.dsdtControlProduccion.Rows(i)("Preferencial")


                If i = 0 Then
                    pPrioridadMaquina = 1
                Else
                    If pMaquinaActual = pMaquinaAnterior Then
                        pPrioridadMaquina = pPrioridadMaquina + 1
                    Else
                        pPrioridadMaquina = 1
                    End If
                End If

                If i = 0 Then
                    If Not DsControlProduccion1.dsdtControlProduccion.Rows(i)("PrioridadMaquina") = pPrioridadMaquina Then
                        DsControlProduccion1.dsdtControlProduccion.Rows(i)("PrioridadMaquina") = pPrioridadMaquina
                        mSQLUpdate.UPDATE_ProgramacionProduccion_Prioridad(DsControlProduccion1.dsdtControlProduccion.Rows(i)("CodigoArticulo").ToString, pPrioridadMaquina.ToString)
                    End If
                Else
                    If Not DsControlProduccion1.dsdtControlProduccion.Rows(i)("PrioridadMaquina") = pPrioridadMaquina Or Not pMaquinaActual = pMaquinaAnterior Then
                        DsControlProduccion1.dsdtControlProduccion.Rows(i)("PrioridadMaquina") = pPrioridadMaquina
                        mSQLUpdate.UPDATE_ProgramacionProduccion_Prioridad(DsControlProduccion1.dsdtControlProduccion.Rows(i)("CodigoArticulo").ToString, pPrioridadMaquina.ToString)
                    End If
                End If


            Next



            'Dim pPrioridadMaquina As Integer = 1
            'For i = 0 To DsControlProduccion1.dsdtControlProduccion.Rows.Count - 1
            '    If i = 0 Then
            '        DsControlProduccion1.dsdtControlProduccion.Rows(i)("PrioridadMaquina") = 1
            '    Else
            '        Dim pMaquinaAnterior As String = String.Empty
            '        Dim pMaquinaActual As String = String.Empty
            '        pMaquinaAnterior = DsControlProduccion1.dsdtControlProduccion.Rows(Val(i - 1))("Preferencial")
            '        pMaquinaActual = DsControlProduccion1.dsdtControlProduccion.Rows(i)("Preferencial")

            '        If pMaquinaActual = pMaquinaAnterior Then
            '            pPrioridadMaquina = pPrioridadMaquina + 1
            '        Else
            '            pPrioridadMaquina = 1
            '        End If
            '        If Not DsControlProduccion1.dsdtControlProduccion.Rows(i)("PrioridadMaquina") = pPrioridadMaquina Or Not pMaquinaActual = pMaquinaAnterior Then
            '            DsControlProduccion1.dsdtControlProduccion.Rows(i)("PrioridadMaquina") = pPrioridadMaquina
            '            mSQLUpdate.UPDATE_ProgramacionProduccion_Prioridad(DsControlProduccion1.dsdtControlProduccion.Rows(i)("CodigoArticulo").ToString, pPrioridadMaquina.ToString)
            '        End If
