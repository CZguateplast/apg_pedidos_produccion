          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dsdtProduccionPadresTableAdapter" GeneratorDataComponentClassName="dsdtProduccionPadresTableAdapter" Name="dsdtProduccionPadres" UserDataComponentName="dsdtProduccionPadresTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="SBOGuateplastConnectionString (MySettings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT 
 CodigoArticulo,
 B.ItemName [NombreArticulo],
 SUM(Planeado) [Planeado],
 SUM(Completado) [Completado],
 SUM(Pendiente) [Pendiente] 
 FROM(
 Select 
 SUBSTRING(A.ItemCode,1,8) [CodigoArticulo], 
 CONVERT(INTEGER,A.PlannedQty) [Planeado],
 CONVERT(INTEGER,A.CmpltQty) [Completado], 
 CONVERT(INTEGER,CASE WHEN (A.PlannedQty - A.CmpltQty) &gt; 0 THEN (A.PlannedQty - A.CmpltQty) ELSE '0' END) [Pendiente] 
 FROM SBOGuateplast.dbo.OWOR A 
 WHERE A.ItemCode LIKE ('CP%')  
 AND Status IN ('R','P') 
 ) A
 LEFT JOIN SBOGuateplast.dbo.OITM B ON B.ItemCode = A.CodigoArticulo
 WHERE CodigoArticulo = 'CP000125'
 GROUP BY CodigoArticulo,B.ItemName
 ORDER BY Pendiente DESC
 </CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
