 FROM SBOGuateplast.dbo.OWOR A 
 LEFT JOIN SBOGuateplast.dbo.OITM B ON B.ItemCode = A.ItemCode
 WHERE A.ItemCode LIKE ('CP%')  
 AND Status IN ('R','P') 
