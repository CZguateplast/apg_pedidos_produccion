          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dsdtProduccionOrdenTableAdapter" GeneratorDataComponentClassName="dsdtProduccionOrdenTableAdapter" Name="dsdtProduccionOrden" UserDataComponentName="dsdtProduccionOrdenTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="SBOGuateplastConnectionString (MySettings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText> SELECT
 A.DocNum [NumSAP], 
 CASE  
 WHEN Status = 'R' THEN 'Liberado'  
 WHEN Status = 'P' THEN 'Planeado' 	 
 WHEN Status = 'L' THEN 'Close'  
 END [Estado], 

 CASE 
 WHEN Type = 'S' THEN 'Estándar' 
 WHEN Type = 'P' THEN 'Especial' 
 WHEN Type = 'D' THEN 'Desmontar' 
 END [Tipo], 

 CONVERT(INTEGER,PlannedQty) [Planeado], 
 CONVERT(INTEGER,CmpltQty) [Completado], 
 CONVERT(INTEGER,CASE WHEN (PlannedQty - CmpltQty) &gt; 0 THEN (PlannedQty - CmpltQty) ELSE '0' END) [Pendiente], 
 CONVERT(DATE,PostDate,105) [Creación], 
 CONVERT(DATE,DueDate,105) [Vencimiento], 
 CONVERT(INTEGER,CONVERT(DATE,GETDATE(),105) - PostDate) [Dias Atrasado],
 C.Origen,
 C.Destino [Destino],
 C.GrupoCliente [GrupoCliente],
 C.CodigoCliente [CodigoCliente],
 C.NumeroOrden [NumeroOrden],
 C.NumeroCampana [Campaña],
 C.Entrega [Entrega],
 C.Comentario_Nivel1 [Comentario1],
 C.Comentario_Nivel2 [Comentario2],
 C.Bit_UsuarioCreacion [Creacion]
 FROM SBOGuateplast.dbo.OWOR A 
 LEFT JOIN SBOGuateplast.dbo.OITM B ON B.ItemCode = A.ItemCode 
 LEFT JOIN APGProduccion.dbo.PROD_Ordenes_Detalle C ON C.NumeroSAP = A.DocNum
 WHERE A.ItemCode LIKE ('CP%')  
 AND Status IN ('R','P') 
 AND A.ItemCode = 'CP000125-ARR-0'
 ORDER BY Status,NumSAP DESC</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
