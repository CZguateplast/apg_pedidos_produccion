        <Tables>
          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dsdtControlProduccionTableAdapter" GeneratorDataComponentClassName="dsdtControlProduccionTableAdapter" Name="dsdtControlProduccion" UserDataComponentName="dsdtControlProduccionTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="SBOGuateplastConnectionString (MySettings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="false" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT
F.Preferencial [Preferencial] ,
F.Estado [Estado],
ISNULL(C.Prioridad,0) [Prioridad],
F.PrioridadMaquina [PrioridadMaquina],
X.CodigoArticulo, 
B.ItemName [NombreArticulo], 
CONVERT(INTEGER,SUM(A.PlannedQty)) [Planeado], 
CONVERT(INTEGER,SUM(A.CmpltQty)) [Completado],  
CONVERT(INTEGER,CASE WHEN (SUM(A.PlannedQty) - SUM(A.CmpltQty)) &gt; 0 THEN (SUM(A.PlannedQty) - SUM(A.CmpltQty)) ELSE '0' END) [Pendiente],  
'' [ProduccionHora],
0 [HorasPendiente],
F.Comentarios [Comentarios]
FROM APGProduccion.dbo.PROD_ProgramacionProduccion X
LEFT JOIN SBOGuateplast.dbo.OWOR A ON SUBSTRING(A.ItemCode,1,8)  = X.CodigoArticulo COLLATE SQL_Latin1_General_CP850_CI_AS AND A.ItemCode LIKE ('CP%') AND Status IN ('R','P')  
LEFT JOIN SBOGuateplast.dbo.OITM B ON B.ItemCode = X.CodigoArticulo COLLATE SQL_Latin1_General_CP850_CI_AS
LEFT JOIN APGProduccion.dbo.PROD_EmergenciasProduccion_Plan C ON C.CodigoArticulo = X.CodigoArticulo COLLATE SQL_Latin1_General_CP850_CI_AS AND C.Id = (SELECT MAX(Id) FROM APGProduccion.dbo.PROD_EmergenciasProduccion_Plan)
LEFT JOIN APGProduccion.dbo.PROD_CodigosProducidos D ON D.Id = B.ItemCode COLLATE SQL_Latin1_General_CP850_CI_AS 
--LEFT JOIN APGProduccion.dbo.PROD_Moldes E ON E.Id = D.Molde 'NO TIENE FUNCION
LEFT JOIN APGProduccion.dbo.PROD_ProgramacionProduccion F ON F.CodigoArticulo = X.CodigoArticulo COLLATE SQL_Latin1_General_CP1_CI_AS
WHERE X.CodigoArticulo COLLATE SQL_Latin1_General_CP850_CI_AS IN (SELECT CodigoArticulo FROM APGProduccion.dbo.PROD_ProgramacionProduccion)
GROUP BY X.Preferencial,X.CodigoArticulo,F.Preferencial,F.Estado,C.Prioridad,F.PrioridadMaquina,B.ItemCode,B.ItemName,F.Comentarios
ORDER BY X.Preferencial,F.PrioridadMaquina ASC</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
