        <Tables>
          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dsdtIngresoAnalisisCPTableAdapter" GeneratorDataComponentClassName="dsdtIngresoAnalisisCPTableAdapter" Name="dsdtIngresoAnalisisCP" UserDataComponentName="dsdtIngresoAnalisisCPTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="SBOGuateplastConnectionString (MySettings)" DbObjectName="SELECT CASE WHEN A.U_NoDeLinea = '1' THEN 'NO' ELSE 'SI' END [DeLinea], A.ItemCode [CodigoArticulo], CONVERT(INTEGER,A.OnHand) [StockTotal], (SELECT ISNULL(CONVERT(INTEGER,OnHand),0) FROM SBOGuateplast.dbo.OITW WHERE ItemCode = A.ItemCode AND WhsCode = 'Almacen')[Almacen], (SELECT ISNULL(CONVERT(INTEGER,OnHand),0) FROM SBOGuateplast.dbo.OITW WHERE ItemCode = A.ItemCode AND WhsCode = 'Metasa')[Metasa], (SELECT ISNULL(CONVERT(INTEGER,OnHand),0) FROM SBOGuateplast.dbo.OITW WHERE ItemCode = A.ItemCode AND WhsCode = 'Pradera')[Pradera], (SELECT ISNULL(SUM( CASE WHEN PlannedQty &gt; CmpltQty THEN CONVERT(INTEGER,(PlannedQty - CmpltQty)) ELSE '0' END),0) [Diferencia] FROM SBOGuateplast.dbo.OWOR A2 WHERE A2.ItemCode = A.ItemCode AND A2.Status IN ('P','R') AND A2.U_Tipo IN ('0')) [Produccion], (SELECT ISNULL(SUM( CASE WHEN a2.PlannedQty &gt; A2.CmpltQty THEN CONVERT(INTEGER,(A2.PlannedQty - A2.CmpltQty)* B2.BaseQty) ELSE '0' END),0) [Diferencia] FROM SBOGuateplast.dbo.OWOR A2 LEFT JOIN SBOGuateplast.dbo.WOR1 B2 ON B2.DocEntry = A2.DocEntry WHERE B2.ItemCode = A.ItemCode AND A2.Status IN ('P','R') AND A2.U_Tipo IN ('0','1')) [Comprometido] FROM SBOGuateplast. dbo.OITM A WHERE A.ItemCode LIKE 'CP000121%' AND LEN(A.ItemCode) &gt; '8'" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT 
DeLinea,
CodigoArticulo,
StockTotal,
Almacen,Metasa,
Pradera,
Produccion,
Comprometido ,
((StockTotal + Produccion)- comprometido) [Disponible]
FROM (
SELECT
CASE WHEN A.U_NoDeLinea = '1' THEN 'NO' ELSE 'SI' END [DeLinea],
A.ItemCode [CodigoArticulo],
CONVERT(INTEGER,A.OnHand) [StockTotal],
(Select ISNULL(CONVERT(INTEGER,OnHand),0) FROM SBOGuateplast.dbo.OITW WHERE ItemCode = A.ItemCode AND WhsCode = 'Almacen')[Almacen],
(Select ISNULL(CONVERT(INTEGER,OnHand),0) FROM SBOGuateplast.dbo.OITW WHERE ItemCode = A.ItemCode AND WhsCode = 'Metasa')[Metasa],
(Select ISNULL(CONVERT(INTEGER,OnHand),0) FROM SBOGuateplast.dbo.OITW WHERE ItemCode = A.ItemCode AND WhsCode = 'Pradera')[Pradera],
(SELECT
  ISNULL(SUM(
  CASE
  WHEN PlannedQty &gt; CmpltQty
  THEN CONVERT(INTEGER,(PlannedQty - CmpltQty))
  ELSE '0'
  END),0) [Diferencia]
  FROM SBOGuateplast.dbo.OWOR A2
  WHERE A2.ItemCode = A.ItemCode AND A2.Status IN ('P','R') AND A2.U_Tipo IN ('0')) [Produccion],
(SELECT
  ISNULL(SUM(
  CASE
  WHEN a2.PlannedQty &gt; A2.CmpltQty
  THEN CONVERT(INTEGER,(A2.PlannedQty - A2.CmpltQty)* B2.BaseQty)
  ELSE '0'
  END),0) [Diferencia]
  FROM SBOGuateplast.dbo.OWOR A2
  LEFT JOIN SBOGuateplast.dbo.WOR1 B2 ON B2.DocEntry = A2.DocEntry
  WHERE B2.ItemCode = A.ItemCode AND A2.Status IN ('P','R') AND A2.U_Tipo IN ('0','1')) [Comprometido]
FROM SBOGuateplast.	dbo.OITM A
WHERE A.ItemCode LIKE 'CP000121%'
AND LEN(A.ItemCode) &gt; '8') B</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
