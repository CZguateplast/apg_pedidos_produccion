          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dsdtComponentesProducidosTableAdapter" GeneratorDataComponentClassName="dsdtComponentesProducidosTableAdapter" Name="dsdtComponentesProducidos" UserDataComponentName="dsdtComponentesProducidosTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="SBOGuateplastConnectionString (MySettings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>            SELECT
              A.Code [CodigoArticulo],
              B.Code [CodigoCP],
              C.ItemName [NombreCP],
              CONVERT(INTEGER,C.OnHand) [Stock],
              C.InvntryUom [U/M],
              B.Quantity [Cantidad], 
              (SELECT CONVERT(DECIMAL(18,0),ISNULL(OnHand,0)) [Almacen] FROM SBOGuateplast.dbo.OITW
              WHERE ItemCode =  B.Code
              AND WhsCode = 'Almacen'
              ) [Almacen],
              (SELECT CONVERT(DECIMAL(18,0),ISNULL(OnHand,0)) [Metasa] FROM SBOGuateplast.dbo.OITW
              WHERE ItemCode =  B.Code
              AND WhsCode = 'Metasa'
              ) [Metasa],
              (SELECT CONVERT(DECIMAL(18,0),ISNULL(OnHand,0)) [Pradera] FROM SBOGuateplast.dbo.OITW
              WHERE ItemCode =  B.Code
              AND WhsCode = 'Pradera'
              ) [Pradera],

              (SELECT CONVERT(DECIMAL(18,0),ISNULL(OnHand,0)) [Pradera] FROM SBOGuateplast.dbo.OITW
              WHERE ItemCode = B.Code
              AND WhsCode = 'MaquinaB'
              ) [MaquinaB],

               (SELECT  ISNULL(SUM(  CASE  WHEN PlannedQty &gt; CmpltQty  THEN CONVERT(INTEGER,(PlannedQty - CmpltQty))  ELSE '0'  END),0) [Diferencia]  
              FROM SBOGuateplast.dbo.OWOR A2  
                 WHERE A2.ItemCode = C.ItemCode
              AND A2.Status IN ('P','R') 
              AND A2.U_Tipo IN ('0')) [Produccion],  

              (SELECT  ISNULL(SUM(  CASE  WHEN a2.PlannedQty &gt; A2.CmpltQty  THEN CONVERT(INTEGER,(A2.PlannedQty - A2.CmpltQty)* B2.BaseQty)  ELSE '0'  END),0) [Diferencia]  
              FROM SBOGuateplast.dbo.OWOR A2  
              LEFT JOIN SBOGuateplast.dbo.WOR1 B2 ON B2.DocEntry = A2.DocEntry  
              WHERE B2.ItemCode = C.ItemCode AND A2.Status IN ('P','R') 
              AND A2.U_Tipo IN ('0','1')) [Comprometido], 

              CONVERT(DECIMAL(18,2),'0') [Producir]
              FROM SBOGuateplast.dbo.OITT A
              LEFT JOIN SBOGuateplast.dbo.ITT1 B ON B.Father = A.Code
              LEFT JOIN SBOGuateplast.dbo.OITM C ON C.ItemCode = B.Code
              WHERE A.Code =  'ar011691-az-0' 
              AND (B.Code LIKE ('CP%')
              OR B.Code LIKE ('AR%'))</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
