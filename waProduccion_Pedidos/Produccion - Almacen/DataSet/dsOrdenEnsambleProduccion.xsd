          <TableAdapter BaseClass="System.ComponentModel.Component" DataAccessorModifier="AutoLayout, AnsiClass, Class, Public" DataAccessorName="dsdtArticuloSeleccionadoTableAdapter" GeneratorDataComponentClassName="dsdtArticuloSeleccionadoTableAdapter" Name="dsdtArticuloSeleccionado" UserDataComponentName="dsdtArticuloSeleccionadoTableAdapter">
            <MainSource>
              <DbSource ConnectionRef="SBOGuateplastConnectionString (MySettings)" DbObjectType="Unknown" FillMethodModifier="Public" FillMethodName="Fill" GenerateMethods="Both" GenerateShortCommands="false" GeneratorGetMethodName="GetData" GeneratorSourceName="Fill" GetMethodModifier="Public" GetMethodName="GetData" QueryType="Rowset" ScalarCallRetval="System.Object, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" UseOptimisticConcurrency="true" UserGetMethodName="GetData" UserSourceName="Fill">
                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>            SELECT 
              CASE
              WHEN A1.U_NoDeLinea = '0' THEN 'SI'
              WHEN A1.U_NoDeLinea = '1' THEN 'NO'
              END [DeLinea],
              UPPER(A1.ItemCode) [CodigoArticulo],
              UPPER(A1.ItemName) [NombreArticulo],
              CONVERT(INTEGER,ISNULL(A1.OnHand,0)) [Stock],

              (SELECT
              ISNULL(SUM(CASE
              WHEN PlannedQty &gt; CmpltQty 
              THEN CONVERT(INTEGER,(PlannedQty - CmpltQty))
              ELSE '0'
              END),0) [Diferencia]
              FROM SBOGuateplast.dbo.OWOR A2
              WHERE A2.ItemCode = A1.ItemCode
              AND A2.Status IN ('P','R')
              AND A2.U_Tipo IN ('1','2','3','4')) [Ensamble],

              (SELECT
              ISNULL(SUM(CASE
              WHEN PlannedQty &gt; CmpltQty 
              THEN CONVERT(INTEGER,(PlannedQty - CmpltQty))
              ELSE '0'
              END),0) [Diferencia]
              FROM SBOGuateplast.dbo.OWOR A2
              WHERE A2.ItemCode = A1.ItemCode
              AND A2.Status IN ('P','R')
              AND A2.U_Tipo IN ('0')) [Produccion],

              (SELECT 
              ISNULL(CONVERT(INTEGER,SUM(B3.OpenQty)),0) [DeudaRol]
              FROM SBOGuateplast.dbo.ORDR A3
              LEFT JOIN SBOGuateplast.dbo.RDR1 B3 ON B3.DocEntry = A3.DocEntry
              WHERE B3.ItemCode = A1.ItemCode
              AND B3.LineStatus = 'O'
              AND A3.DocStatus = 'O'
              AND A3.CANCELED = 'N'
              AND A3.U_NameCamp IS NULL) [DeudaRol],

              (SELECT 
              ISNULL(CONVERT(INTEGER,SUM(B3.OpenQty)),0) [DeudaRol]
              FROM SBOGuateplast.dbo.ORDR A3
              LEFT JOIN SBOGuateplast.dbo.RDR1 B3 ON B3.DocEntry = A3.DocEntry
              WHERE B3.ItemCode = A1.ItemCode
              AND B3.LineStatus = 'O'
              AND A3.DocStatus = 'O'
              AND A3.CANCELED = 'N'
              AND A3.U_NameCamp &lt;&gt; '') [DeudaCampana],

              ISNULL((SELECT
              SUM(CASE
              WHEN Proyectado &gt; Facturado 
              THEN (Proyectado - Facturado)
              ELSE '0'
              END) [DeudaProyeccion]
              FROM
              (SELECT
              BB1.Proyectado,
              (SELECT 
              ISNULL(CONVERT(INTEGER,SUM(A5.Quantity)),0) [Facturado]
              FROM SBOGuateplast.dbo.INV1 A5
              LEFT JOIN SBOGuateplast.dbo.OINV B1 ON B1.DocEntry = A5.DocEntry
              WHERE A5.BaseEntry IN 
              (SELECT DISTINCT AA.DocEntry
              FROM SBOGuateplast.dbo.DLN1 AA
              WHERE AA.BaseEntry IN 
              (SELECT DISTINCT AAA.DocEntry
              FROM SBOGuateplast.dbo.ORDR AAA
              LEFT JOIN SBOGuateplast.dbo.RDR1 BBB ON BBB.DocEntry = AAA.DocEntry
              WHERE AAA.U_NameCamp COLLATE SQL_Latin1_General_CP850_CI_AS = AA1.Id
              AND BBB.ItemCode = A1.ItemCode
              AND AAA.CANCELED = 'N')
              AND AA.ItemCode = A1.ItemCode
              AND AA.TargetType &lt;&gt; '16')
              AND A5.ItemCode = A1.ItemCode
              AND A5.TargetType &lt;&gt; '14') [Facturado]
              FROM Ventas.dbo.CAM_Encabezado AA1
              LEFT JOIN Ventas.dbo.CAM_Detalle BB1 ON BB1.Id = AA1.Id 
              WHERE FechaFinal &gt; GETDATE()
              AND LEN(AA1.Id) &lt; 8
              AND AA1.Distribuidor = '0'
              AND BB1.CodigoArticulo = A1.ItemCode COLLATE SQL_Latin1_General_CP850_CI_AS) [Qry2]),0) [DeudaProyeccion],

              CONVERT(INTEGER,A1.MinLevel) [StockMinimo],
              CONVERT(INTEGER, A1.MaxLevel) [StockMaximo]
              FROM SBOGuateplast.dbo.OITM A1
              WHERE A1.ItemCode in ('AR011691-AZ-0')
              AND LEN(A1.ItemCode) &gt; 8</CommandText>
                    <Parameters />
                  </DbCommand>
                </SelectCommand>
              </DbSource>
            </MainSource>
